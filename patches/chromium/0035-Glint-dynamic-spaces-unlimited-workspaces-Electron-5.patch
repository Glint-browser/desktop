+void VerticalTabStripRegionView::GlintCreateSpace() {
+  const size_t n = glint_spaces_.size();
+  GlintSpace space;
+  space.name = u"Space " + base::NumberToString16(n + 1);
+  space.color = kGlintSpacePalette.at(n % kGlintSpacePalette.size());
+  glint_spaces_.push_back(std::move(space));
+  GlintRebuildSpaceDots();
+  // Switching to the brand-new space opens a fresh tab in it.
+  GlintSwitchSpace(static_cast<int>(n));
+}
+
+std::optional<int> VerticalTabStripRegionView::GlintSpaceIndexAtScreenPoint(
+    const gfx::Point& point_in_screen) const {
+  for (size_t i = 0; i < glint_space_dots_.size(); ++i) {
+    views::LabelButton* dot = glint_space_dots_.at(i);
+    if (dot && dot->GetBoundsInScreen().Contains(point_in_screen)) {
+      return static_cast<int>(i);
+    }
+  }
+  return std::nullopt;
+}
