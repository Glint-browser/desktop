@@ -190,6 +192,47 @@ VerticalTabStripRegionView::VerticalTabStripRegionView(
   glint_browser_ = browser_view->browser();
   glint_browser_->tab_strip_model()->AddObserver(this);
 
+  // Glint: back / forward / reload buttons at the very top of the sidebar,
+  // to the right of the macOS traffic lights (Arc style).
+  using GlintNavCommand = void (*)(BrowserWindowInterface*,
+                                   WindowOpenDisposition);
+  auto make_nav_button = [this](GlintNavCommand command,
+                                const gfx::VectorIcon& icon,
+                                std::u16string_view tooltip) {
+    auto button = std::make_unique<views::ImageButton>(base::BindRepeating(
+        command,
+        base::Unretained(
+            static_cast<BrowserWindowInterface*>(glint_browser_.get())),
+        WindowOpenDisposition::CURRENT_TAB));
+    button->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(icon, ui::kColorIcon, 18));
+    button->SetTooltipText(std::u16string(tooltip));
+    button->SetInstallFocusRingOnFocus(false);
+    views::InkDrop::Get(button.get())
+        ->SetMode(views::InkDropHost::InkDropMode::ON);
+    views::InkDrop::Get(button.get())
+        ->GetInkDrop()
+        ->SetShowHighlightOnHover(true);
+    views::InstallRoundRectHighlightPathGenerator(button.get(), gfx::Insets(),
+                                                  6);
+    return button;
+  };
+  auto nav_row = std::make_unique<views::View>();
+  auto* nav_box = nav_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal));
+  nav_box->set_between_child_spacing(10);
+  // Left margin clears the traffic lights.
+  nav_row->SetProperty(views::kMarginsKey,
+                       gfx::Insets::TLBR(8, 78, 2, region_horizontal_padding));
+  nav_row->AddChildView(
+      make_nav_button(&chrome::GoBack, kArrowBackIcon, u"Back"));
+  nav_row->AddChildView(
+      make_nav_button(&chrome::GoForward, kArrowForwardIcon, u"Forward"));
+  nav_row->AddChildView(
+      make_nav_button(&chrome::Reload, vector_icons::kRefreshIcon, u"Reload"));
+  AddChildView(std::move(nav_row));
+
   // Address bar row: the text field plus a trailing "copy link" button.
   // BoxLayout keeps the row at the text field's natural height (the field
   // flexes to fill width; the button stays fixed).
@@ -200,10 +243,9 @@ VerticalTabStripRegionView::VerticalTabStripRegionView(
