   gemini_button_ = AddChildView(std::make_unique<views::View>());
 
@@ -1438,6 +1530,13 @@ void VerticalTabStripRegionView::GlintAdoptOrphanTabs() {
   }
 }
 
+void VerticalTabStripRegionView::GlintNewTab() {
+  if (!glint_browser_) {
+    return;
+  }
+  chrome::AddTabAt(glint_browser_, GURL(), -1, /*foreground=*/true);
+}
+
 void VerticalTabStripRegionView::GlintHandleNewTab() {
   GlintAdoptOrphanTabs();
   // Arc-style: a fresh, empty tab starts you in the address bar.
