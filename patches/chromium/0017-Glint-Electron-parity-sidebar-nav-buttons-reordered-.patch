   top_button_container_ =
       AddChildView(std::make_unique<VerticalTabStripTopContainer>(
@@ -333,6 +413,16 @@ VerticalTabStripRegionView::VerticalTabStripRegionView(
   top_button_container_->SetVisible(false);
