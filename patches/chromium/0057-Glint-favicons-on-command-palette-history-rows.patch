+  // Glint: swap the generic history glyph for the site's favicon as lookups
+  // resolve. Rows are matched back by URL, so results landing after the list
+  // was rebuilt for a newer query stay correct (or match nothing).
+  void RequestRowFavicons(Profile* profile, const std::vector<GURL>& urls) {
+    favicon::FaviconService* service = FaviconServiceFactory::GetForProfile(
+        profile, ServiceAccessType::EXPLICIT_ACCESS);
+    if (!service) {
+      return;
+    }
+    for (const GURL& url : urls) {
+      service->GetFaviconImageForPageURL(
+          url,
+          base::BindOnce(&GlintCommandPaletteView::OnFaviconLoaded,
+                         base::Unretained(this), url),
+          &tracker_);
+    }
+  }
+
+  void OnFaviconLoaded(const GURL& url,
+                       const favicon_base::FaviconImageResult& result) {
+    if (result.image.IsEmpty()) {
+      return;
+    }
+    bool changed = false;
+    for (Row& row : rows_) {
+      if ((row.type == Row::Type::kHistory ||
+           row.type == Row::Type::kProfileHistory) &&
+          row.url == url) {
+        row.icon = ui::ImageModel::FromImage(result.image);
+        changed = true;
+      }
+    }
+    if (changed) {
+      RebuildList();
+    }
+  }
+
