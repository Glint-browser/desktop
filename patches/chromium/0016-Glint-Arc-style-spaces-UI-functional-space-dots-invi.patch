+namespace {
+
+// Glint spaces: display names, sidebar dot colors, and tab-group colors.
+constexpr std::array<const char16_t*, 3> kGlintSpaceNames = {u"Personal",
+                                                             u"Work", u"Play"};
+constexpr std::array<SkColor, 3> kGlintSpaceDotColors = {
+    SkColorSetRGB(0x7c, 0x5c, 0xff),   // purple
+    SkColorSetRGB(0x27, 0xae, 0x8f),   // teal
+    SkColorSetRGB(0xef, 0x9a, 0x3d)};  // amber
+constexpr std::array<tab_groups::TabGroupColorId, 3> kGlintSpaceGroupColors = {
+    tab_groups::TabGroupColorId::kPurple, tab_groups::TabGroupColorId::kCyan,
+    tab_groups::TabGroupColorId::kOrange};
+
+}  // namespace
+
+void VerticalTabStripRegionView::UpdateGlintSpaceDots() {
+  for (size_t i = 0; i < glint_space_dots_.size(); ++i) {
+    views::LabelButton* dot = glint_space_dots_.at(i);
+    if (!dot) {
+      continue;
+    }
+    const bool active = (static_cast<int>(i) == glint_active_space_);
+    const SkColor color = kGlintSpaceDotColors.at(i);
+    dot->SetPreferredSize(active ? gfx::Size(22, 8) : gfx::Size(8, 8));
+    dot->SetBackground(views::CreateRoundedRectBackground(
+        active ? color : SkColorSetA(color, 0x66), 4.f));
+    dot->SetTooltipText(std::u16string(kGlintSpaceNames.at(i)));
+  }
+  if (glint_workspace_name_) {
+    glint_workspace_name_->SetText(std::u16string(
+        kGlintSpaceNames.at(static_cast<size_t>(glint_active_space_))));
+  }
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::GlintAdoptOrphanTabs() {
+  if (!glint_browser_) {
+    return;
+  }
+  TabStripModel* tsm = glint_browser_->tab_strip_model();
+  TabGroupModel* group_model = tsm->group_model();
+  if (!group_model) {
+    return;
+  }
+  std::vector<int> orphans;
+  for (int i = 0; i < tsm->count(); ++i) {
+    if (!tsm->IsTabPinned(i) && !tsm->GetTabGroupForTab(i).has_value()) {
+      orphans.push_back(i);
+    }
+  }
+  if (orphans.empty()) {
+    return;
+  }
+  const size_t space = static_cast<size_t>(glint_active_space_);
+  std::optional<tab_groups::TabGroupId>& group = glint_space_groups_.at(space);
+  if (group && group_model->ContainsTabGroup(*group)) {
+    tsm->AddToExistingGroup(orphans, *group);
+  } else {
+    group = tsm->AddToNewGroup(orphans);
+    tsm->ChangeTabGroupVisuals(
+        *group,
+        tab_groups::TabGroupVisualData(
+            std::u16string(kGlintSpaceNames.at(space)),
+            kGlintSpaceGroupColors.at(space), /*is_collapsed=*/false),
+        /*is_customized=*/true);
+  }
+}
+
+void VerticalTabStripRegionView::GlintHandleNewTab() {
+  GlintAdoptOrphanTabs();
+  // Arc-style: a fresh, empty tab starts you in the address bar.
+  if (!glint_browser_ || !glint_address_bar_) {
+    return;
+  }
+  content::WebContents* wc =
+      glint_browser_->tab_strip_model()->GetActiveWebContents();
+  const GURL url = wc ? wc->GetVisibleURL() : GURL();
+  if (!url.is_valid() || url.IsAboutBlank() ||
+      (url.SchemeIs("chrome") && url.host() == "newtab")) {
+    glint_address_bar_->RequestFocus();
+  }
+}
+
+void VerticalTabStripRegionView::GlintSwitchSpace(int space_index) {
+  if (!glint_browser_ || space_index == glint_active_space_) {
+    return;
+  }
+  TabStripModel* tsm = glint_browser_->tab_strip_model();
+  TabGroupModel* group_model = tsm->group_model();
+  if (!group_model) {
+    return;
+  }
+  // Stored groups vanish when their last tab closes; drop stale ids.
+  for (auto& group : glint_space_groups_) {
+    if (group && !group_model->ContainsTabGroup(*group)) {
+      group.reset();
+    }
+  }
+  // The outgoing space adopts any ungrouped tabs so they stay together (and
+  // collapse away) once we leave it.
+  GlintAdoptOrphanTabs();
+
+  glint_active_space_ = space_index;
+  UpdateGlintSpaceDots();
+
+  const size_t new_space = static_cast<size_t>(space_index);
+  std::optional<tab_groups::TabGroupId> target =
+      glint_space_groups_.at(new_space);
+  if (target) {
+    // Returning to a space: activate the first tab of its group.
+    const gfx::Range tabs = group_model->GetTabGroup(*target)->ListTabs();
+    if (!tabs.is_empty()) {
+      tsm->ActivateTabAt(static_cast<int>(tabs.start()));
+    }
+  } else {
+    // First visit: open a fresh tab and group it under this space.
+    chrome::AddTabAt(glint_browser_, GURL(), -1, /*foreground=*/true);
+    const int new_index = tsm->active_index();
+    if (new_index < 0) {
+      return;
+    }
+    target = tsm->AddToNewGroup({new_index});
+    glint_space_groups_.at(new_space) = target;
+  }
+  // Expand the target space's group; collapse the other spaces'.
+  for (size_t i = 0; i < glint_space_groups_.size(); ++i) {
+    const std::optional<tab_groups::TabGroupId>& group_id =
+        glint_space_groups_.at(i);
+    if (!group_id || !group_model->ContainsTabGroup(*group_id)) {
+      continue;
+    }
+    tsm->ChangeTabGroupVisuals(
+        *group_id,
+        tab_groups::TabGroupVisualData(std::u16string(kGlintSpaceNames.at(i)),
+                                       kGlintSpaceGroupColors.at(i),
+                                       /*is_collapsed=*/i != new_space),
+        /*is_customized=*/true);
+  }
+}
