+        glint::RestartToApplyUpdate(glint_profile);
       } else if (base::StartsWith(glint_spec, "glint://delete-profile/")) {
         glint::DeleteGlintProfile(base::UnescapeBinaryURLComponent(
             glint_spec.substr(strlen("glint://delete-profile/"))));
