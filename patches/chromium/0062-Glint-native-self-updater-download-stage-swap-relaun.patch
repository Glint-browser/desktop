+#ifndef CHROME_BROWSER_UI_VIEWS_GLINT_GLINT_UPDATER_H_
+#define CHROME_BROWSER_UI_VIEWS_GLINT_GLINT_UPDATER_H_
+
+class GURL;
+class Profile;
+
+namespace glint {
+
+// Glint's self-updater. Downloads a release archive (zip of Glint.app),
+// stages the new bundle under the user data dir, and — on demand — swaps it
+// over the running app and relaunches. Progress and results are pushed into
+// the Glint UI extension's chrome.storage under "glintUpdateStatus", which
+// the settings page renders (downloading percent / restart button / errors).
+
+// Begins download + staging. Only URLs under https://github.com/Glint-browser/
+// are accepted (plus localhost when --glint-test-updates is present).
+void StartUpdateDownload(Profile* profile, const GURL& url);
+
+// Swaps the staged bundle over the running app bundle and relaunches.
+void RestartToApplyUpdate(Profile* profile);
+
+}  // namespace glint
+
+#endif  // CHROME_BROWSER_UI_VIEWS_GLINT_GLINT_UPDATER_H_
