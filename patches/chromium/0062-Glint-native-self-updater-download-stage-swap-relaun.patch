+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/values.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/lifetime/application_lifetime.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/chrome_paths.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/storage_partition.h"
+#include "extensions/browser/api/storage/storage_frontend.h"
+#include "extensions/browser/extension_registry.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+
+namespace glint {
+
+namespace {
+
+constexpr int64_t kMaxArchiveBytes = 1024 * 1024 * 1024;  // 1 GiB
+
+struct UpdateState {
+  std::unique_ptr<network::SimpleURLLoader> loader;
+  int64_t total_bytes = 0;
+  int last_percent = -1;
+};
+
+UpdateState& GetState() {
+  static base::NoDestructor<UpdateState> state;
+  return *state;
+}
+
+base::FilePath UpdateDir() {
+  base::FilePath user_data;
+  base::PathService::Get(chrome::DIR_USER_DATA, &user_data);
+  return user_data.Append("GlintUpdate");
+}
+
+base::FilePath StagedAppPath() {
+  return UpdateDir().Append("staged").Append("Glint.app");
+}
+
+// Pushes {state, ...} into the Glint UI extension's chrome.storage — the
+// settings page listens on storage.onChanged and renders it.
+void WriteUpdateStatus(Profile* profile, base::DictValue status) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  Profile* original = profile->GetOriginalProfile();
+  const extensions::ExtensionSet& extension_set =
+      extensions::ExtensionRegistry::Get(original)->enabled_extensions();
+  for (const auto& extension : extension_set) {
+    if (extension->name() != "Glint UI") {
+      continue;
+    }
+    extensions::StorageFrontend* frontend =
+        extensions::StorageFrontend::Get(original);
+    if (!frontend) {
+      break;
+    }
+    frontend->RunWithStorage(
+        extension, extensions::settings_namespace::LOCAL,
+        base::BindOnce(
+            [](base::DictValue status, value_store::ValueStore* store) {
+              store->Set(value_store::ValueStore::DEFAULTS,
+                         "glintUpdateStatus",
+                         base::Value(std::move(status)));
+            },
+            std::move(status)));
+    break;
+  }
+}
+
+void ReportError(Profile* profile, const std::string& message) {
+  base::DictValue status;
+  status.Set("state", "error");
+  status.Set("message", message);
+  WriteUpdateStatus(profile, std::move(status));
+}
+
+bool RunTool(const std::vector<std::string>& argv) {
+  base::LaunchOptions options;
+  base::Process process = base::LaunchProcess(argv, options);
+  if (!process.IsValid()) {
+    return false;
+  }
+  int exit_code = -1;
+  process.WaitForExit(&exit_code);
+  return exit_code == 0;
+}
+
+// Blocking: unzip the archive and sanity-check the staged bundle.
+bool StageArchive(base::FilePath zip_path) {
+  const base::FilePath staged_dir = UpdateDir().Append("staged");
+  base::DeletePathRecursively(staged_dir);
+  if (!RunTool({"/usr/bin/ditto", "-x", "-k", zip_path.value(),
+                staged_dir.value()})) {
+    return false;
+  }
+  const base::FilePath staged_binary =
+      StagedAppPath().Append("Contents").Append("MacOS").Append("Glint");
+  if (!base::PathExists(staged_binary)) {
+    return false;
+  }
+  // Downloads written by the network stack carry no quarantine, but be
+  // defensive — a quarantined bundle would hit Gatekeeper on relaunch.
+  RunTool({"/usr/bin/xattr", "-cr", StagedAppPath().value()});
+  return true;
+}
+
+void OnStaged(Profile* profile, bool ok) {
+  if (!ok) {
+    ReportError(profile, "Could not unpack the update.");
+    return;
+  }
+  base::DictValue status;
+  status.Set("state", "downloaded");
+  WriteUpdateStatus(profile, std::move(status));
+}
+
+void OnDownloadComplete(Profile* profile, base::FilePath path) {
+  UpdateState& state = GetState();
+  state.loader.reset();
+  if (path.empty()) {
+    ReportError(profile, "Download failed — check your connection.");
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&StageArchive, path),
+      base::BindOnce(&OnStaged, profile));
+}
+
+void OnDownloadProgress(Profile* profile, uint64_t current) {
+  UpdateState& state = GetState();
+  if (state.total_bytes <= 0) {
+    return;
+  }
+  const int percent =
+      static_cast<int>(current * 100 / static_cast<uint64_t>(state.total_bytes));
+  if (percent == state.last_percent || percent - state.last_percent < 2) {
+    return;
+  }
+  state.last_percent = percent;
+  base::DictValue status;
+  status.Set("state", "downloading");
+  status.Set("percent", percent);
+  WriteUpdateStatus(profile, std::move(status));
+}
+
+void OnResponseStarted(const GURL& final_url,
+                       const network::mojom::URLResponseHead& head) {
+  GetState().total_bytes = head.content_length;
+}
+
+void BeginDownload(Profile* profile, const GURL& url, bool dir_ready) {
+  if (!dir_ready) {
+    ReportError(profile, "Could not prepare the update directory.");
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+
+  UpdateState& state = GetState();
+  state.total_bytes = 0;
+  state.last_percent = -1;
+  state.loader = network::SimpleURLLoader::Create(
+      std::move(request), MISSING_TRAFFIC_ANNOTATION);
+  state.loader->SetOnResponseStartedCallback(
+      base::BindOnce(&OnResponseStarted));
+  state.loader->SetOnDownloadProgressCallback(
+      base::BindRepeating(&OnDownloadProgress, profile));
+  state.loader->DownloadToFile(
+      profile->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&OnDownloadComplete, profile),
+      UpdateDir().Append("update.zip"), kMaxArchiveBytes);
+}
+
+// Blocking: prepare a clean update dir.
+bool PrepareDir() {
+  base::DeletePathRecursively(UpdateDir());
+  return base::CreateDirectory(UpdateDir());
+}
+
+// Blocking: swap the staged bundle over the running app. Returns the target
+// bundle path, or empty on failure.
+base::FilePath SwapBundles() {
+  const base::FilePath staged = StagedAppPath();
+  if (!base::PathExists(
+          staged.Append("Contents").Append("MacOS").Append("Glint"))) {
+    return {};
+  }
+  const base::FilePath target = base::apple::OuterBundlePath();
+  if (target.Extension() != ".app") {
+    return {};
+  }
+  const base::FilePath old = UpdateDir().Append("previous.app");
+  base::DeletePathRecursively(old);
+  if (!base::Move(target, old)) {
+    return {};
+  }
+  if (!base::Move(staged, target)) {
+    base::Move(old, target);  // roll back
+    return {};
+  }
+  return target;
+}
+
+void OnSwapped(Profile* profile, base::FilePath target) {
+  if (target.empty()) {
+    ReportError(profile, "Could not install the update.");
+    return;
+  }
+  base::DictValue status;
+  status.Set("state", "idle");
+  WriteUpdateStatus(profile, std::move(status));
+  // Relaunch via a detached shell that waits for this process to exit, then
+  // opens the swapped bundle. The stock relauncher can't be used here: its
+  // helper lives inside the old bundle, which was just moved out from under
+  // the running process.
+  base::LaunchOptions options;
+  options.new_process_group = true;
+  // Forward profile-affecting switches so the relaunched instance lands in
+  // the same profile as the one it replaces (and test runs stay in their
+  // scratch profiles instead of escaping into the default one).
+  std::string forwarded;
+  const base::CommandLine* current = base::CommandLine::ForCurrentProcess();
+  for (const char* flag :
+       {"user-data-dir", "use-mock-keychain", "glint-test-updates"}) {
+    if (current->HasSwitch(flag)) {
+      const std::string value = current->GetSwitchValueASCII(flag);
+      forwarded += " \"--" + std::string(flag) +
+                   (value.empty() ? "" : "=" + value) + "\"";
+    }
+  }
+  const std::string script =
+      "while /bin/kill -0 " +
+      base::NumberToString(base::Process::Current().Pid()) +
+      " 2>/dev/null; do /bin/sleep 0.2; done; /usr/bin/open -n \"" +
+      target.value() + "\"" + (forwarded.empty() ? "" : " --args" + forwarded) +
+      " > \"" + UpdateDir().Append("relaunch.log").value() +
+      "\" 2>&1; echo exit=$? >> \"" +
+      UpdateDir().Append("relaunch.log").value() + "\"";
+  base::LaunchProcess({"/bin/sh", "-c", script}, options);
+  chrome::AttemptExit();
+}
+
+}  // namespace
+
+void StartUpdateDownload(Profile* profile, const GURL& url) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const bool test_updates =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("glint-test-updates");
+  const bool allowed =
+      base::StartsWith(url.spec(), "https://github.com/Glint-browser/") ||
+      (test_updates && url.SchemeIs("http") && url.host() == "127.0.0.1");
+  if (!allowed || GetState().loader) {
+    return;
+  }
+  base::DictValue status;
+  status.Set("state", "downloading");
+  status.Set("percent", 0);
+  WriteUpdateStatus(profile, std::move(status));
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&PrepareDir),
+      base::BindOnce(&BeginDownload, profile, url));
+}
+
+void RestartToApplyUpdate(Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&SwapBundles), base::BindOnce(&OnSwapped, profile));
+}
+
+}  // namespace glint
