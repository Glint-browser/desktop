From f82a5ff8e8c4f6d6be6ed9de091e12af76f5e360 Mon Sep 17 00:00:00 2001
From: Mathias <77238760+MathiasMortus@users.noreply.github.com>
Date: Mon, 17 Aug 2026 08:45:02 +0200
Subject: [PATCH 61/66] Glint: survive oversized group titles + stop
 tracked-pref extension purges
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Corrupted marker-accumulated group titles overflowed SessionCommand's
size_type and CHECK-crashed every session save (Clone span mismatch) —
clamp the pickled title. Tracked-pref enforcement silently uninstalled
every extension when a crash tore a Preferences write or a profile
hopped between dev and official builds; run without it (Vivaldi/Brave-
style), the anti-tampering MACs cost far more than they protect here.
---
 chrome/browser/prefs/chrome_pref_service_factory.cc  | 11 ++++-------
 chrome/browser/resources/glint_ui/chunks/update.js   |  2 +-
 components/sessions/core/session_service_commands.cc |  5 ++++-
 3 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/chrome/browser/prefs/chrome_pref_service_factory.cc b/chrome/browser/prefs/chrome_pref_service_factory.cc
index cd4f964e72..164de47d7b 100644
--- a/chrome/browser/prefs/chrome_pref_service_factory.cc
+++ b/chrome/browser/prefs/chrome_pref_service_factory.cc
@@ -222,14 +222,11 @@ SettingsEnforcementGroup GetSettingsEnforcementGroup() {
   }
 #endif
 
-  // Use the strongest enforcement setting on Windows and MacOS. Remember to
-  // update the OFFICIAL_BUILD section of extension_startup_browsertest.cc and
-  // pref_hash_browsertest.cc when updating the default value below.
-#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
-  return GROUP_ENFORCE_DEFAULT;
-#else
+  // Glint: no tracked-pref enforcement. The anti-tampering MACs misfire when
+  // profiles hop between dev (non-enforcing) and official builds or when a
+  // crash tears a Preferences write — and the penalty is silently dropping
+  // every installed extension. Vivaldi/Brave-style forks run without it.
   return GROUP_NO_ENFORCEMENT;
-#endif
 }
 
 // Returns the effective preference tracking configuration.
