+TabDragTarget* VerticalTabStripRegionView::GetTabDragTarget(
+    const gfx::Point& point_in_screen) {
+  // A drag over a bookmark folder row targets Glint's drop-to-file behavior;
+  // anywhere else falls through to the stock tab-strip drag handling.
+  if (GlintFolderIdAtScreenPoint(point_in_screen).has_value()) {
+    glint_last_drag_point_ = point_in_screen;
+    return this;
+  }
+  return BaseTabStripRegionView::GetTabDragTarget(point_in_screen);
+}
+
+std::optional<int64_t> VerticalTabStripRegionView::GlintFolderIdAtScreenPoint(
+    const gfx::Point& point_in_screen) const {
+  if (!glint_bookmarks_list_ || !glint_bookmarks_list_->GetVisible()) {
+    return std::nullopt;
+  }
+  for (const auto& [row, node_id] : glint_folder_row_ids_) {
+    if (row->GetBoundsInScreen().Contains(point_in_screen)) {
+      return node_id;
+    }
+  }
+  return std::nullopt;
+}
+
+void VerticalTabStripRegionView::OnTabDragEntered() {}
+
+TabDragContext* VerticalTabStripRegionView::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  glint_last_drag_point_ = point_in_screen;
+  // Keep the dragged tab attached to this window's strip while it hovers a
+  // folder row, instead of tearing off into a new window.
+  return drag_handler_ ? drag_handler_->GetDragContext() : nullptr;
+}
+
+void VerticalTabStripRegionView::OnTabDragExited(
+    const gfx::Point& point_in_screen) {}
+
+void VerticalTabStripRegionView::OnTabDragEnded() {}
+
+bool VerticalTabStripRegionView::CanDropTab() {
+  return GlintFolderIdAtScreenPoint(glint_last_drag_point_).has_value();
+}
+
+void VerticalTabStripRegionView::HandleTabDrop(
+    TabDragTarget::DragController& controller) {
+  const std::optional<int64_t> folder_id =
+      GlintFolderIdAtScreenPoint(glint_last_drag_point_);
+  content::WebContents* contents =
+      controller.GetSessionData().source_dragged_contents();
+  if (!folder_id || !contents || !glint_browser_) {
+    return;
+  }
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(glint_browser_->profile());
+  if (!model || !model->loaded()) {
+    return;
+  }
+  const bookmarks::BookmarkNode* folder =
+      bookmarks::GetBookmarkNodeByID(model, *folder_id);
+  const GURL url = contents->GetLastCommittedURL();
+  if (!folder || !folder->is_folder() || !url.is_valid()) {
+    return;
+  }
+  std::u16string title(contents->GetTitle());
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(url.spec());
+  }
+  model->AddURL(folder, 0, title, url);
+  // Auto-expand the folder so the drop result is immediately visible (the
+  // model notification rebuilds the tree).
+  glint_expanded_bookmark_folders_.insert(*folder_id);
+}
+
+base::CallbackListSubscription
+VerticalTabStripRegionView::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return glint_drop_target_destroy_callbacks_.Add(std::move(callback));
+}
