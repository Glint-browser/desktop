+    if (key_event.key_code() == ui::VKEY_ESCAPE) {
+      glint_folder_name_field_ = nullptr;
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&VerticalTabStripRegionView::GlintRebuildBookmarksList,
+                         weak_ptr_factory_.GetWeakPtr()));
+      return true;
+    }
+    return false;
+  }
+  if (sender != glint_address_bar_) {
+    return false;
+  }
