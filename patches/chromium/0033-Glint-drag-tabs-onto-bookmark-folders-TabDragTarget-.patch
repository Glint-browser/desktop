+      glint_folder_name_field_ = nullptr;
+      bookmarks::BookmarkModel* model = BookmarkModelFactory::GetForBrowserContext(
+          glint_browser_->profile());
+      if (model && model->loaded()) {
+        // The model notification rebuilds the tree (replacing the editor row).
+        model->AddFolder(model->bookmark_bar_node(), 0, name);
