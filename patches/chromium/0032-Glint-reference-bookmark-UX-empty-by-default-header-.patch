+
+  auto new_folder_button = std::make_unique<views::ImageButton>(
+      base::BindRepeating(
+          &VerticalTabStripRegionView::GlintCreateBookmarkFolder,
+          base::Unretained(this)));
+  new_folder_button->SetImageModel(
       views::Button::STATE_NORMAL,
       ui::ImageModel::FromVectorIcon(vector_icons::kFolderFilledIcon,
