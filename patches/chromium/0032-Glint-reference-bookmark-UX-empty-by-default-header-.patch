-    empty->SetHorizontalAlignment(gfx::ALIGN_LEFT);
-    glint_bookmarks_list_->AddChildView(std::move(empty));
-  }
+  // Empty by default: the tree only shows once folders/bookmarks exist.
+  glint_bookmarks_list_->SetVisible(row_budget < 40);
   InvalidateLayout();
 }
 
@@ -1676,9 +1666,9 @@ void VerticalTabStripRegionView::GlintRemoveBookmark(int64_t node_id) {
