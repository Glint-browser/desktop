+  // Keep the tree live: any bookmark change (star button, folder creation,
+  // removals) rebuilds it, including the initial model load.
   if (bookmarks::BookmarkModel* bookmark_model =
           BookmarkModelFactory::GetForBrowserContext(
               glint_browser_->profile())) {
     glint_bookmark_observation_.Observe(bookmark_model);
   }
+  GlintRebuildBookmarksList();
 
   // Glint: thin separator between the Bookmark row and the tab list, matching
   // the reference sidebar.
@@ -1533,17 +1528,17 @@ void VerticalTabStripRegionView::GlintAdoptOrphanTabs() {
   }
 }
 
-void VerticalTabStripRegionView::GlintToggleBookmarks() {
