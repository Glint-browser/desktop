+  // The label takes the remaining width, pushing the button to the right.
+  workspace_box->SetFlexForView(glint_workspace_name_, 1);
+  AddChildView(std::move(workspace_row));
+
+  // Glint: the bookmarks/folders tree. Empty (and hidden) by default — the
+  // header's folder button creates folders, which appear here as rows.
   auto bookmarks_list = std::make_unique<views::View>();
   auto* bookmarks_list_layout =
       bookmarks_list->SetLayoutManager(std::make_unique<views::FlexLayout>());
   bookmarks_list_layout->SetOrientation(views::LayoutOrientation::kVertical);
