 }
 
 void VerticalTabStripRegionView::GlintRebuildBookmarksList() {
@@ -1558,13 +1553,8 @@ void VerticalTabStripRegionView::GlintRebuildBookmarksList() {
     GlintAddBookmarkRows(model->bookmark_bar_node(), 0, row_budget);
     GlintAddBookmarkRows(model->other_node(), 0, row_budget);
   }
-  if (row_budget == 40) {
-    auto empty = std::make_unique<views::Label>(
