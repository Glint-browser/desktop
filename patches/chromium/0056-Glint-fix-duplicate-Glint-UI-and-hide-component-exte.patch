+++ b/chrome/browser/resources/glint_ublock/manifest.json
@@ -306,7 +306,7 @@
     ]
   },
   "default_locale": "en",
-  "description": "__MSG_extShortDesc__",
+  "description": "Efficient content blocker bundled with Glint.",
   "host_permissions": [
     "<all_urls>"
   ],
@@ -319,7 +319,7 @@
   },
   "manifest_version": 3,
   "minimum_chrome_version": "122.0",
-  "name": "__MSG_extName__",
+  "name": "uBlock Origin Lite",
   "options_page": "dashboard.html",
   "permissions": [
     "activeTab",
diff --git a/chrome/browser/ui/toolbar/toolbar_actions_model.cc b/chrome/browser/ui/toolbar/toolbar_actions_model.cc
index b12903bf85..1435d96bbf 100644
--- a/chrome/browser/ui/toolbar/toolbar_actions_model.cc
+++ b/chrome/browser/ui/toolbar/toolbar_actions_model.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/toolbar/toolbar_actions_model.h"
 
+#include "extensions/common/manifest.h"
+
 #include <algorithm>
 #include <memory>
 #include <string>
@@ -274,6 +276,12 @@ void ToolbarActionsModel::OnReady() {
 
 bool ToolbarActionsModel::ShouldAddExtension(
     const extensions::Extension* extension) {
+  // Glint: component extensions (the Glint UI sidebar, bundled adblockers)
+  // are part of the browser itself and never appear in the extensions menu.
+  if (extensions::Manifest::IsComponentLocation(extension->location())) {
+    return false;
+  }
+
   // In incognito mode, don't add any extensions that aren't incognito-enabled.
   if (profile_->IsOffTheRecord() &&
       !extensions::util::IsIncognitoEnabled(extension->id(), profile_)) {
