+void VerticalTabStripRegionView::GlintAddBookmarkRows(
+    const bookmarks::BookmarkNode* folder,
+    int depth,
+    int& row_budget) {
+  for (const auto& node : folder->children()) {
+    if (row_budget <= 0) {
+      return;
+    }
+    const bool is_folder = node->is_folder();
+    if (!is_folder && !node->is_url()) {
+      continue;
+    }
+    --row_budget;
+    const int64_t node_id = node->id();
+    const bool expanded =
+        is_folder && glint_expanded_bookmark_folders_.contains(node_id);
+
+    auto row = std::make_unique<views::View>();
+    auto* row_box = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal));
+    row_box->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    row->SetProperty(views::kMarginsKey,
+                     gfx::Insets::TLBR(0, depth * 12, 0, 0));
+
+    auto entry = std::make_unique<views::LabelButton>(
+        is_folder
+            ? base::BindRepeating(
+                  &VerticalTabStripRegionView::GlintToggleBookmarkFolder,
+                  base::Unretained(this), node_id)
+            : base::BindRepeating(&VerticalTabStripRegionView::GlintOpenUrl,
+                                  base::Unretained(this), node->url()),
+        node->GetTitle());
+    entry->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(
+            is_folder ? (expanded ? vector_icons::kFolderOpenIcon
+                                  : vector_icons::kFolderFilledIcon)
+                      : kStarIcon,
+            ui::kColorIcon, 16));
+    entry->SetImageLabelSpacing(8);
+    entry->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    entry->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(3, 8)));
+    entry->SetInstallFocusRingOnFocus(false);
+    views::InkDrop::Get(entry.get())
+        ->SetMode(views::InkDropHost::InkDropMode::ON);
+    views::InkDrop::Get(entry.get())
+        ->GetInkDrop()
+        ->SetShowHighlightOnHover(true);
+    views::InstallRoundRectHighlightPathGenerator(entry.get(), gfx::Insets(),
+                                                  8);
+    auto* entry_ptr = row->AddChildView(std::move(entry));
+    row_box->SetFlexForView(entry_ptr, 1);
+
+    if (!is_folder) {
+      auto remove_button =
+          std::make_unique<views::ImageButton>(base::BindRepeating(
+              &VerticalTabStripRegionView::GlintRemoveBookmark,
+              base::Unretained(this), node_id));
+      remove_button->SetImageModel(
+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(vector_icons::kCloseIcon,
+                                         ui::kColorIcon, 12));
+      remove_button->SetTooltipText(u"Remove bookmark");
+      row->AddChildView(std::move(remove_button));
+    }
+    glint_bookmarks_list_->AddChildView(std::move(row));
+
+    if (expanded) {
+      GlintAddBookmarkRows(node.get(), depth + 1, row_budget);
+    }
+  }
+}
+
+void VerticalTabStripRegionView::GlintToggleBookmarkFolder(int64_t node_id) {
+  if (glint_expanded_bookmark_folders_.contains(node_id)) {
+    glint_expanded_bookmark_folders_.erase(node_id);
+  } else {
+    glint_expanded_bookmark_folders_.insert(node_id);
+  }
+  // Deferred: rebuilding destroys the clicked folder row, which must not be
+  // deleted from inside its own press callback.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&VerticalTabStripRegionView::GlintRebuildBookmarksList,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void VerticalTabStripRegionView::GlintRemoveBookmark(int64_t node_id) {
+  if (!glint_browser_) {
+    return;
+  }
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(glint_browser_->profile());
+  if (!model || !model->loaded()) {
+    return;
+  }
+  const bookmarks::BookmarkNode* node =
+      bookmarks::GetBookmarkNodeByID(model, node_id);
+  if (!node || node->is_permanent_node()) {
+    return;
+  }
+  // The resulting model notification rebuilds the list via a posted task, so
+  // the row hosting this button is never deleted inside its own callback.
+  model->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser, FROM_HERE);
+}
+
+void VerticalTabStripRegionView::BookmarkModelChanged() {
+  if (!glint_bookmarks_list_ || !glint_bookmarks_list_->GetVisible()) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&VerticalTabStripRegionView::GlintRebuildBookmarksList,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
