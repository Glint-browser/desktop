From 42bfa34db447f5b9a3b37d17f234734fca1f46fc Mon Sep 17 00:00:00 2001
From: Glint <glint@localhost>
Date: Sat, 4 Jul 2026 20:21:22 +0200
Subject: [PATCH 05/62] Glint spaces: focus mode - expanding a group collapses
 the others

---
 chrome/browser/ui/views/tabs/tab_strip.cc | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/chrome/browser/ui/views/tabs/tab_strip.cc b/chrome/browser/ui/views/tabs/tab_strip.cc
index f1c750f983..d506d86f3c 100644
--- a/chrome/browser/ui/views/tabs/tab_strip.cc
+++ b/chrome/browser/ui/views/tabs/tab_strip.cc
@@ -1818,6 +1818,25 @@ void TabStrip::ToggleTabGroupCollapsedState(
   if (tab_count != GetTabCount()) {
     tab_container_->ExitTabClosingMode();
   }
+
+  // Glint spaces: focus mode. When a group (space) is expanded, collapse every
+  // other group so only one space's tabs are visible at a time — the Arc-style
+  // "switch spaces" behavior. Collecting the group ids first (before mutating)
+  // keeps the tab walk safe.
+  if (!IsGroupCollapsed(group)) {
+    std::vector<tab_groups::TabGroupId> other_groups;
+    for (int i = 0; i < GetTabCount(); ++i) {
+      if (std::optional<tab_groups::TabGroupId> g = tab_at(i)->group();
+          g.has_value() && g.value() != group) {
+        other_groups.push_back(g.value());
+      }
+    }
+    for (const tab_groups::TabGroupId& other : other_groups) {
+      if (!IsGroupCollapsed(other)) {
+        controller_->ToggleTabGroupCollapsedState(other, origin);
+      }
+    }
+  }
 }
 
 void TabStrip::NotifyTabstripBubbleOpened() {
