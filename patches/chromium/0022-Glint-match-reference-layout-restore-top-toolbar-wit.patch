From 77f460b4e3c6d9607a93fda2fc5a777f2d461f6b Mon Sep 17 00:00:00 2001
From: Glint <glint@localhost>
Date: Tue, 21 Jul 2026 09:17:42 +0200
Subject: [PATCH 22/66] Glint: match reference layout - restore top toolbar
 with omnibox hidden, remove sidebar nav row, flat joined content, list
 separator, left-aligned dots

---
 chrome/browser/ui/views/frame/browser_view.cc | 11 +---
 .../ui/views/frame/contents_container_view.cc | 10 ----
 .../frame/vertical_tab_strip_region_view.cc   | 56 ++++---------------
 .../browser/ui/views/toolbar/toolbar_view.cc  |  8 +++
 4 files changed, 20 insertions(+), 65 deletions(-)

diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
index 86a2e93fe2..da4d28fe85 100644
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -2972,13 +2972,6 @@ bool BrowserView::IsToolbarVisible() const {
   // widget, so |toolbar_| is still null.  Return false in this case so callers
   // don't assume they can access the toolbar yet.
   //
-  // Glint: hide the top toolbar entirely for the Arc-style layout — the window
-  // becomes just [ vertical tab sidebar | content ]. Navigation lives in the
-  // sidebar / command palette. Keep the toolbar for non-normal windows (popups,
-  // apps) which rely on it.
-  if (browser_->is_type_normal() && toolbar_) {
-    return false;
-  }
   return (browser_->SupportsWindowFeature(
               Browser::WindowFeature::kFeatureToolbar) ||
           browser_->SupportsWindowFeature(
@@ -5923,9 +5916,7 @@ void BrowserView::FrameColorsChanged() {
     web_app_window_title_->SetBackgroundColor(frame_color);
     web_app_window_title_->SetEnabledColor(caption_color);
   }
-  // Glint: fill the widget with the frame color so the margin around the
-  // floating rounded content card reads as the sidebar gray (Arc style).
-  GetWidget()->SetBackgroundColor(ui::kColorFrameActive);
+  GetWidget()->SetBackgroundColor(kColorToolbar);
 }
 
 void BrowserView::UpdateAccessibleNameForAllTabs() {
diff --git a/chrome/browser/ui/views/frame/contents_container_view.cc b/chrome/browser/ui/views/frame/contents_container_view.cc
