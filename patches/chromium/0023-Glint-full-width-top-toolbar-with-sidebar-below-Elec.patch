@@ -309,6 +309,10 @@ class VerticalTabStripRegionView final
   void GlintHandleNewTab();
   // Opens a fresh foreground tab in the active space ("New Tab" row / "+").
   void GlintNewTab();
+  // Expands/collapses the bookmarks folder in the sidebar, listing the
+  // bookmark bar's entries as clickable rows.
+  void GlintToggleBookmarks();
+  raw_ptr<views::View> glint_bookmarks_list_ = nullptr;
   int glint_active_space_ = 0;
   std::array<std::optional<tab_groups::TabGroupId>, 3> glint_space_groups_;
   std::array<raw_ptr<views::LabelButton>, 3> glint_space_dots_ = {};
