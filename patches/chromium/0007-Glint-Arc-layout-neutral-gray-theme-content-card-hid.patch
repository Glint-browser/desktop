+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -2971,6 +2971,14 @@ bool BrowserView::IsToolbarVisible() const {
   // It's possible to reach here before we've been notified of being added to a
   // widget, so |toolbar_| is still null.  Return false in this case so callers
   // don't assume they can access the toolbar yet.
+  //
+  // Glint: hide the top toolbar entirely for the Arc-style layout — the window
+  // becomes just [ vertical tab sidebar | content ]. Navigation lives in the
+  // sidebar / command palette. Keep the toolbar for non-normal windows (popups,
+  // apps) which rely on it.
+  if (browser_->is_type_normal() && toolbar_) {
+    return false;
+  }
   return (browser_->SupportsWindowFeature(
               Browser::WindowFeature::kFeatureToolbar) ||
           browser_->SupportsWindowFeature(
