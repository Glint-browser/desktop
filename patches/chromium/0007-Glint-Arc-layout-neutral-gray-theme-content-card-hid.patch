From ff6828cc2507f13c2468a3d40e2c730ad6b52cae Mon Sep 17 00:00:00 2001
From: Glint <glint@localhost>
Date: Sun, 5 Jul 2026 20:21:33 +0200
Subject: [PATCH 07/62] Glint Arc layout: neutral gray theme, content card,
 hide top toolbar, airier tabs

---
 chrome/browser/themes/theme_service.cc             | 14 ++++++++------
 chrome/browser/ui/layout_constants.cc              |  2 +-
 chrome/browser/ui/views/frame/browser_view.cc      |  8 ++++++++
 .../ui/views/frame/contents_container_view.cc      |  6 ++++++
 4 files changed, 23 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/themes/theme_service.cc b/chrome/browser/themes/theme_service.cc
index 86c53c02f1..2742f09a11 100644
--- a/chrome/browser/themes/theme_service.cc
+++ b/chrome/browser/themes/theme_service.cc
@@ -303,9 +303,11 @@ void ThemeService::RegisterProfilePrefs(
       prefs::kDeprecatedBrowserColorVariantDoNotUse,
       static_cast<int>(ui::mojom::BrowserColorVariant::kSystem),
       user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
+  // Glint: use the Neutral color variant so the gray seed yields a clean,
+  // desaturated gray UI (like the original Glint) rather than a tinted one.
   registry->RegisterIntegerPref(
       prefs::kBrowserColorVariant,
-      static_cast<int>(ui::mojom::BrowserColorVariant::kSystem));
+      static_cast<int>(ui::mojom::BrowserColorVariant::kNeutral));
   registry->RegisterBooleanPref(
       prefs::kDeprecatedGrayscaleThemeEnabledDoNotUse, false,
       user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
@@ -764,11 +766,11 @@ void ThemeService::SetUserColor(std::optional<SkColor> user_color) {
 }
 
 std::optional<SkColor> ThemeService::GetUserColor() const {
-  // Glint: when the user hasn't picked a theme color, seed the whole browser
-  // (frame, sidebar, tabs, accents) with Glint's brand purple so it looks like
-  // Glint out of the box. Users can still override via "Customize Glint".
-  constexpr SkColor kGlintSeedColor = SkColorSetRGB(0x6d, 0x5b, 0xd0);
-  return CurrentThemeUserColor(profile_->GetPrefs()).value_or(kGlintSeedColor);
+  // Glint: seed a clean neutral gray (matching the original Glint's gray
+  // sidebar) when the user hasn't picked a color. Combined with the Neutral
+  // color variant this desaturates the whole UI. Users can still override.
+  constexpr SkColor kGlintNeutralSeed = SkColorSetRGB(0x8a, 0x8a, 0x8a);
+  return CurrentThemeUserColor(profile_->GetPrefs()).value_or(kGlintNeutralSeed);
 }
 
 void ThemeService::SetBrowserColorVariant(
