From d6194ff0a0834bb6a854ac0f4426ccdf5270568f Mon Sep 17 00:00:00 2001
From: Glint <glint@localhost>
Date: Sat, 4 Jul 2026 18:51:51 +0200
Subject: [PATCH 04/61] Glint theme: purple brand seed color + default to Light
 mode

---
 chrome/browser/themes/theme_service.cc | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/themes/theme_service.cc b/chrome/browser/themes/theme_service.cc
index bf9cb4c809..86c53c02f1 100644
--- a/chrome/browser/themes/theme_service.cc
+++ b/chrome/browser/themes/theme_service.cc
@@ -290,9 +290,11 @@ void ThemeService::RegisterProfilePrefs(
       prefs::kDeprecatedBrowserColorSchemeDoNotUse,
       std::to_underlying(ThemeService::BrowserColorScheme::kSystem),
       user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
+  // Glint: default the browser UI to Light mode (like the original Glint's
+  // bright, airy look) regardless of the OS setting. Users can still switch.
   registry->RegisterIntegerPref(
       prefs::kBrowserColorScheme,
-      std::to_underlying(ThemeService::BrowserColorScheme::kSystem));
+      std::to_underlying(ThemeService::BrowserColorScheme::kLight));
   registry->RegisterIntegerPref(
       prefs::kDeprecatedUserColorDoNotUse, SK_ColorTRANSPARENT,
       user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
@@ -762,7 +764,11 @@ void ThemeService::SetUserColor(std::optional<SkColor> user_color) {
 }
 
 std::optional<SkColor> ThemeService::GetUserColor() const {
-  return CurrentThemeUserColor(profile_->GetPrefs());
+  // Glint: when the user hasn't picked a theme color, seed the whole browser
+  // (frame, sidebar, tabs, accents) with Glint's brand purple so it looks like
+  // Glint out of the box. Users can still override via "Customize Glint".
+  constexpr SkColor kGlintSeedColor = SkColorSetRGB(0x6d, 0x5b, 0xd0);
+  return CurrentThemeUserColor(profile_->GetPrefs()).value_or(kGlintSeedColor);
 }
 
