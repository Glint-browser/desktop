+// One result row: [icon] [title, elided] ............ [meta, secondary].
+class PaletteRow : public views::Button {
+  METADATA_HEADER(PaletteRow, views::Button)
+
+ public:
+  PaletteRow(PressedCallback callback,
+             const ui::ImageModel& icon,
+             const std::u16string& label,
+             const std::u16string& meta,
+             bool selected)
+      : views::Button(std::move(callback)) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::TLBR(0, 14, 0, 14), 12));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    auto* icon_view = AddChildView(std::make_unique<views::ImageView>());
+    icon_view->SetImage(icon);
+    icon_view->SetImageSize(gfx::Size(kIconSize, kIconSize));
+
+    auto* title = AddChildView(std::make_unique<views::Label>(label));
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title->SetElideBehavior(gfx::ELIDE_TAIL);
+    title->SetEnabledColor(kGlintText);
+    layout->SetFlexForView(title, 1);
+
+    auto* meta_label = AddChildView(std::make_unique<views::Label>(
+        meta, views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    meta_label->SetEnabledColor(kGlintTextDim);
+
+    SetPreferredSize(gfx::Size(kPaletteWidth - 16, kRowHeight));
+    SetFocusBehavior(FocusBehavior::NEVER);
+    GetViewAccessibility().SetName(label.empty() ? u"result" : label);
+    if (selected) {
+      SetBackground(views::CreateRoundedRectBackground(
+          kGlintHover, static_cast<float>(kRowCornerRadius)));
+    }
+  }
+};
