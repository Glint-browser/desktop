+// URL-or-search heuristic, mirroring the Glint Electron shell. Searches go
+// through the browser's real default search engine.
+GURL ToNavigableUrl(Browser* browser, const std::u16string& query) {
+  const std::string text = base::UTF16ToUTF8(query);
+  const bool looks_like_url =
+      text.find(' ') == std::string::npos && text.find('.') != std::string::npos;
+  if (looks_like_url) {
+    GURL fixed = url_formatter::FixupURL(text, std::string());
+    if (fixed.is_valid()) {
+      return fixed;
+    }
+  }
+  TemplateURLService* turl_service =
+      TemplateURLServiceFactory::GetForProfile(browser->profile());
+  if (turl_service) {
+    const TemplateURL* engine = turl_service->GetDefaultSearchProvider();
+    if (engine) {
+      GURL search(engine->url_ref().ReplaceSearchTerms(
+          TemplateURLRef::SearchTermsArgs(query),
+          turl_service->search_terms_data()));
+      if (search.is_valid()) {
+        return search;
+      }
+    }
+  }
+  return GURL("https://www.google.com/search?q=" +
+              base::EscapeQueryParamValue(text, /*use_plus=*/true));
+}
