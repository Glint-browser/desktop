+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/browser/ui/views/glint/glint_glass_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include "ui/views/widget/widget.h"
+
+// NSGlassEffectView intercepts hit testing even when placed below the
+// compositor view (same issue the glass browser frame works around) —
+// pass every hit through to the real content.
+API_AVAILABLE(macos(26.0))
+@interface GlintGlassPassthroughView : NSGlassEffectView
+@end
+
+@implementation GlintGlassPassthroughView
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+@end
+
+namespace glint {
+
+void ApplyLiquidGlass(views::Widget* widget,
+                      int corner_radius,
+                      const gfx::Insets& insets,
+                      SkColor tint) {
+  if (@available(macOS 26, *)) {
+    if (!widget) {
+      return;
+    }
+    NSWindow* ns_window = widget->GetNativeWindow().GetNativeNSWindow();
+    if (!ns_window) {
+      return;
+    }
+    NSView* content_view = [ns_window contentView];
+    if (!content_view) {
+      return;
+    }
+
+    // The glass sits BELOW the compositor view, so it is only visible where
+    // the window itself is transparent. Bubble windows default to an opaque
+    // gray backing — clear it, or the glass never shows at all.
+    ns_window.opaque = NO;
+    ns_window.backgroundColor = [NSColor clearColor];
+
+    // AppKit is bottom-left origin: views' bottom inset becomes y.
+    const NSRect bounds = content_view.bounds;
+    const NSRect glass_frame = NSMakeRect(
+        bounds.origin.x + insets.left(), bounds.origin.y + insets.bottom(),
+        NSWidth(bounds) - insets.width(), NSHeight(bounds) - insets.height());
+
+    NSGlassEffectView* glass =
+        [[GlintGlassPassthroughView alloc] initWithFrame:glass_frame];
+    glass.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    glass.style = NSGlassEffectViewStyleRegular;
+    glass.cornerRadius = corner_radius;
+    glass.tintColor = [NSColor
+        colorWithSRGBRed:SkColorGetR(tint) / 255.0
+                   green:SkColorGetG(tint) / 255.0
+                    blue:SkColorGetB(tint) / 255.0
+                   alpha:SkColorGetA(tint) / 255.0];
+    [content_view addSubview:glass
+                  positioned:NSWindowBelow
+                  relativeTo:nil];
+  }
+}
+
+}  // namespace glint
