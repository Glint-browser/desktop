@@ -7291,6 +7293,50 @@ bool ChromeContentBrowserClient::HandleExternalProtocol(
     mojo::PendingRemote<network::mojom::URLLoaderFactory>* out_factory) {
   CHECK(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
 
+  // Glint: glint://palette opens the native command palette. Used by the
+  // Glint sidebar (a side-panel extension) to trigger browser UI it cannot
+  // reach through extension APIs. Never handed to the OS.
+  if (url.SchemeIs("glint")) {
+    const std::string glint_spec = url.possibly_invalid_spec();
+    content::WebContents* glint_wc = web_contents_getter.Run();
+    Profile* glint_profile =
+        glint_wc ? Profile::FromBrowserContext(glint_wc->GetBrowserContext())
+                 : nullptr;
+    if (glint_profile) {
+      constexpr char kThemePrefix[] = "glint://set-theme/";
+      constexpr char kSearchPrefix[] = "glint://set-search/";
+      if (base::StartsWith(glint_spec, "glint://palette")) {
+        auto* glint_collection =
+            ProfileBrowserCollection::GetForProfile(glint_profile);
+        BrowserWindowInterface* glint_bwi =
+            glint_collection ? glint_collection->GetLastActiveBrowser()
+                             : nullptr;
+        if (glint_bwi) {
+          glint::ShowCommandPalette(glint_bwi->GetBrowserForMigrationOnly());
+        }
+      } else if (base::StartsWith(glint_spec, kThemePrefix)) {
+        glint::ApplyThemeSetting(glint_profile,
+                                 glint_spec.substr(strlen(kThemePrefix)));
+      } else if (base::StartsWith(glint_spec, kSearchPrefix)) {
+        glint::ApplySearchEngineSetting(
+            glint_profile, glint_spec.substr(strlen(kSearchPrefix)));
+      } else if (base::StartsWith(glint_spec, "glint://set-adblock/")) {
+        glint::ApplyAdblockSetting(
+            glint_profile, glint_spec.substr(strlen("glint://set-adblock/")));
+      } else if (base::StartsWith(glint_spec, "glint://adblock-settings")) {
+        auto* glint_collection =
+            ProfileBrowserCollection::GetForProfile(glint_profile);
+        BrowserWindowInterface* glint_bwi =
+            glint_collection ? glint_collection->GetLastActiveBrowser()
+                             : nullptr;
+        if (glint_bwi) {
+          glint::OpenAdblockSettings(glint_bwi->GetBrowserForMigrationOnly());
+        }
+      }
+    }
+    return true;
+  }
+
