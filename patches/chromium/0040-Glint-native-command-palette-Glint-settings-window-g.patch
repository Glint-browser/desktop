+#ifndef CHROME_BROWSER_UI_VIEWS_GLINT_GLINT_COMMAND_PALETTE_H_
+#define CHROME_BROWSER_UI_VIEWS_GLINT_GLINT_COMMAND_PALETTE_H_
+
+#include <string>
+#include <vector>
+
+class Browser;
+class Profile;
+
+namespace glint {
+
+// Shows the Glint command palette for |browser| (bound to ⌘T): search open
+// tabs, browsing history, or type a URL / web search. If a palette is already
+// showing for this browser it is refocused. Header stays views-free so
+// non-views callers (browser_command_controller) can include it.
+void ShowCommandPalette(Browser* browser);
+
+// Opens the Glint settings page (served by the Glint UI extension) in a
+// standalone popup window. Falls back to the native settings if the
+// extension is not installed.
+void OpenGlintSettings(Browser* browser);
+
+// glint://set-theme/<system|light|dark> — flips the native browser color
+// scheme so the Glint settings page controls the real theme.
+void ApplyThemeSetting(Profile* profile, const std::string& value);
+
+// glint://set-search/<google|duckduckgo|bing> — selects the matching
+// prepopulated engine as the browser's real default search provider.
+void ApplySearchEngineSetting(Profile* profile, const std::string& value);
+
+// glint://set-adblock/<on|off> — toggles the bundled uBlock Origin Lite
+// component extension and persists the choice in glint.adblock_enabled.
+void ApplyAdblockSetting(Profile* profile, const std::string& value);
+
+// glint://adblock-settings — opens the bundled adblocker's dashboard.
+void OpenAdblockSettings(Browser* browser);
+
+// ⌥⌘←/→: activates the previous/next workspace (tab group, ordered by tab
+// position, wrapping), focusing its most recently active tab.
+void ActivateAdjacentWorkspace(Browser* browser, int delta);
+
+// "/profile <name> <url>" (command palette): opens |url_text| in the named
+// Glint profile — an isolated named off-the-record session — as a normal tab
+// in |browser|'s window, so several accounts of one site can live side by
+// side in the same workspace.
+void OpenUrlInGlintProfile(Browser* browser,
+                           const std::string& profile_name,
+                           const std::u16string& url_text);
+
+// Names of existing Glint profiles ("glint-*" profile directories),
+// prefix stripped.
+std::vector<std::string> GetGlintProfileNames();
+
+}  // namespace glint
+
+#endif  // CHROME_BROWSER_UI_VIEWS_GLINT_GLINT_COMMAND_PALETTE_H_
