+// Inserts a Liquid Glass (NSGlassEffectView) layer beneath |widget|'s content
+// on macOS 26+. |insets| carves the glass down to the visible panel (a bubble
+// widget's window includes transparent shadow margins), |corner_radius|
+// rounds it, and |tint| (with its alpha) is applied as the glass tint —
+// the widget's own background should be fully transparent. No-op pre-26.
+void ApplyLiquidGlass(views::Widget* widget,
+                      int corner_radius,
+                      const gfx::Insets& insets,
+                      SkColor tint);
