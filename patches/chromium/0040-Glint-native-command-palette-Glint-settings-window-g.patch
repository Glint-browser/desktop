+
+  // views::BubbleDialogDelegateView:
+  views::View* GetInitiallyFocusedView() override { return input_; }
+
+  gfx::Rect GetBubbleBounds() override {
+    // Spotlight placement: horizontally centered, top pinned at ~30% of the
+    // window height (fixed top so the palette doesn't jump as results grow).
+    gfx::Rect bounds = LocationBarBubbleDelegateView::GetBubbleBounds();
+    const gfx::Rect anchor = GetAnchorView()->GetBoundsInScreen();
+    bounds.set_x(anchor.x() + (anchor.width() - bounds.width()) / 2);
+    bounds.set_y(anchor.y() + anchor.height() * 3 / 10);
+    return bounds;
+  }
+
+  void OnWidgetInitialized() override { UpdateResults(); }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    selected_ = 0;
+    UpdateResults();
+  }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    switch (key_event.key_code()) {
+      case ui::VKEY_DOWN:
+        if (selected_ + 1 < rows_.size()) {
+          ++selected_;
+          RebuildList();
+        }
+        return true;
+      case ui::VKEY_UP:
+        if (selected_ > 0) {
+          --selected_;
+          RebuildList();
+        }
+        return true;
+      case ui::VKEY_RETURN:
+        ExecuteRow(selected_);
+        return true;
+      case ui::VKEY_ESCAPE:
+        GetWidget()->Close();
+        return true;
+      default:
+        return false;
+    }
+  }
+
+ private:
+  struct Row {
+    enum class Type {
+      kNewTab,
+      kOpen,
+      kTab,
+      kHistory,
+      kProfile,
+      kProfileName,
+      kProfileHint
+    };
+    Type type;
+    std::u16string label;
+    std::u16string meta;
+    GURL url;
+    int tab_index = -1;
+    ui::ImageModel icon;
+    std::string profile_name;
+    std::u16string profile_url;
+  };
+
+  static ui::ImageModel VectorIcon(const gfx::VectorIcon& icon) {
+    return ui::ImageModel::FromVectorIcon(icon, kGlintTextDim, kIconSize);
+  }
+
+  void UpdateResults() {
+    query_ =
+        std::u16string(base::TrimWhitespace(input_->GetText(), base::TRIM_ALL));
+    const std::u16string& query = query_;
+    const std::u16string query_lower = base::i18n::ToLower(query);
+
+    rows_.clear();
+
+    // "/profile Name url" — open url in an isolated named session.
+    if (base::StartsWith(query, u"/profile", base::CompareCase::SENSITIVE)) {
+      const std::u16string rest = std::u16string(
+          base::TrimWhitespace(query.substr(8), base::TRIM_ALL));
+      const size_t space = rest.find(u' ');
+      if (space != std::u16string::npos && space + 1 < rest.size()) {
+        const std::string name = base::UTF16ToUTF8(rest.substr(0, space));
+        const std::u16string url = rest.substr(space + 1);
+        Row row;
+        row.type = Row::Type::kProfile;
+        row.label = u"Open " + url + u" in \"" +
+                    base::UTF8ToUTF16(name) + u"\"";
+        row.meta = u"Profile";
+        row.icon = VectorIcon(vector_icons::kAccountCircleIcon);
+        row.profile_name = name;
+        row.profile_url = url;
+        rows_.push_back(std::move(row));
+      } else {
+        // Suggest existing profiles (filtered by the partial name typed);
+        // Enter prefills "/profile <name> " ready for the URL.
+        const std::string partial =
+            base::ToLowerASCII(base::UTF16ToUTF8(rest));
+        for (const std::string& name : GetGlintProfileNames()) {
+          if (!partial.empty() &&
+              base::ToLowerASCII(name).find(partial) == std::string::npos) {
+            continue;
+          }
+          Row row;
+          row.type = Row::Type::kProfileName;
+          row.label = base::UTF8ToUTF16(name);
+          row.meta = u"Profile";
+          row.icon = VectorIcon(vector_icons::kAccountCircleIcon);
+          row.profile_name = name;
+          rows_.push_back(std::move(row));
+        }
+        Row hint;
+        hint.type = Row::Type::kProfileHint;
+        hint.label = u"/profile Name <url> — new names create a profile";
+        hint.meta = u"Isolated login";
+        hint.icon = VectorIcon(vector_icons::kAccountCircleIcon);
+        rows_.push_back(std::move(hint));
+      }
+      RebuildList();
+      return;
+    }
+
+    if (query.empty()) {
+      rows_.push_back({Row::Type::kNewTab, u"New Tab", u"⏎", GURL(), -1,
+                       VectorIcon(vector_icons::kAdd2Icon)});
+    } else {
+      rows_.push_back({Row::Type::kOpen, u"Open \"" + query + u"\"",
+                       u"URL or search", GURL(), -1,
+                       VectorIcon(vector_icons::kSearchIcon)});
+    }
+
+    // Open tabs matching the query (always listed when the query is empty).
+    TabStripModel* tabs = browser_->tab_strip_model();
+    size_t tab_rows = 0;
+    for (int i = 0; i < tabs->count() && tab_rows < kMaxTabRows; ++i) {
+      content::WebContents* contents = tabs->GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      const std::u16string title = contents->GetTitle();
+      const GURL url = contents->GetLastCommittedURL();
+      if (!query_lower.empty() &&
+          base::i18n::ToLower(title).find(query_lower) ==
+              std::u16string::npos &&
+          base::UTF8ToUTF16(url.spec()).find(query_lower) ==
+              std::u16string::npos) {
+        continue;
+      }
+      const gfx::Image favicon = favicon::TabFaviconFromWebContents(contents);
+      rows_.push_back({Row::Type::kTab,
+                       title.empty() ? base::UTF8ToUTF16(url.spec()) : title,
+                       u"Switch", url, i,
+                       favicon.IsEmpty()
+                           ? VectorIcon(vector_icons::kGlobeIcon)
+                           : ui::ImageModel::FromImage(favicon)});
+      ++tab_rows;
+    }
+
+    if (selected_ >= rows_.size()) {
+      selected_ = rows_.empty() ? 0 : rows_.size() - 1;
+    }
+    RebuildList();
+
+    // History rows arrive asynchronously and are appended on callback.
+    tracker_.TryCancelAll();
+    if (!query.empty()) {
+      history::HistoryService* history =
+          HistoryServiceFactory::GetForProfile(
+              browser_->profile(), ServiceAccessType::EXPLICIT_ACCESS);
+      if (history) {
+        history::QueryOptions options;
+        options.max_count = kMaxHistoryRows;
+        history->QueryHistory(
+            query, options,
+            base::BindOnce(&GlintCommandPaletteView::OnHistoryResults,
+                           base::Unretained(this)),
+            &tracker_);
+      }
+    }
+  }
+
+  void OnHistoryResults(history::QueryResults results) {
+    TabStripModel* tabs = browser_->tab_strip_model();
+    for (const history::URLResult& result : results) {
+      bool already_open = false;
+      for (int i = 0; i < tabs->count(); ++i) {
+        content::WebContents* contents = tabs->GetWebContentsAt(i);
+        if (contents && contents->GetLastCommittedURL() == result.url()) {
+          already_open = true;
+          break;
+        }
+      }
+      if (already_open) {
+        continue;
+      }
+      rows_.push_back({Row::Type::kHistory,
+                       result.title().empty()
+                           ? base::UTF8ToUTF16(result.url().spec())
+                           : result.title(),
+                       u"History", result.url(), -1,
+                       VectorIcon(vector_icons::kHistoryIcon)});
+    }
+    RebuildList();
+  }
+
+  void RebuildList() {
+    list_->RemoveAllChildViews();
+    for (size_t i = 0; i < rows_.size(); ++i) {
+      list_->AddChildView(std::make_unique<PaletteRow>(
+          base::BindRepeating(&GlintCommandPaletteView::ExecuteRow,
+                              base::Unretained(this), i),
+          rows_[i].icon, rows_[i].label, rows_[i].meta, i == selected_));
+    }
+    if (GetWidget()) {
+      SizeToContents();
+    }
+  }
+
+  void ExecuteRow(size_t index) {
+    if (index >= rows_.size()) {
+      return;
+    }
+    const Row row = rows_[index];
+    if (row.type == Row::Type::kProfileHint) {
+      return;  // informational row — keep the palette open
+    }
+    if (row.type == Row::Type::kProfileName) {
+      // Prefill the command with the chosen profile; the user types the URL.
+      input_->SetText(u"/profile " + base::UTF8ToUTF16(row.profile_name) +
+                      u" ");
+      selected_ = 0;
+      UpdateResults();
+      return;
+    }
+    const std::u16string query = query_;
+    Browser* browser = browser_;
+    GetWidget()->Close();
+
+    switch (row.type) {
+      case Row::Type::kProfileHint:
+      case Row::Type::kProfileName:
+        return;
+      case Row::Type::kProfile:
+        OpenUrlInGlintProfile(browser, row.profile_name, row.profile_url);
+        break;
+      case Row::Type::kNewTab:
+        chrome::NewTab(browser, NewTabTypes::kNewTabCommand);
+        break;
+      case Row::Type::kTab:
+        browser->tab_strip_model()->ActivateTabAt(row.tab_index);
+        break;
+      case Row::Type::kOpen:
+      case Row::Type::kHistory: {
+        const GURL url = row.type == Row::Type::kOpen
+                             ? ToNavigableUrl(browser, query)
+                                                      : row.url;
+        NavigateParams params(browser, url, ui::PAGE_TRANSITION_TYPED);
+        params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+        Navigate(&params);
+        break;
+      }
+    }
+  }
+
+  static GlintCommandPaletteView* instance_;
+
+  const raw_ptr<Browser> browser_;
+  raw_ptr<views::Textfield> input_ = nullptr;
+  raw_ptr<views::Separator> separator_ = nullptr;
+  raw_ptr<views::View> list_ = nullptr;
+  std::vector<Row> rows_;
+  std::u16string query_;
+  size_t selected_ = 0;
+  base::CancelableTaskTracker tracker_;
+};
+
+// static
+GlintCommandPaletteView* GlintCommandPaletteView::instance_ = nullptr;
+
+BEGIN_METADATA(GlintCommandPaletteView)
+END_METADATA
+
+}  // namespace
+
+void ApplyThemeSetting(Profile* profile, const std::string& value) {
+  ThemeService* theme_service = ThemeServiceFactory::GetForProfile(profile);
+  if (!theme_service) {
+    return;
+  }
+  ThemeService::BrowserColorScheme scheme =
+      ThemeService::BrowserColorScheme::kSystem;
+  if (value == "light") {
+    scheme = ThemeService::BrowserColorScheme::kLight;
+  } else if (value == "dark") {
+    scheme = ThemeService::BrowserColorScheme::kDark;
+  }
+  theme_service->SetBrowserColorScheme(scheme);
+}
+
+void ApplySearchEngineSetting(Profile* profile, const std::string& value) {
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(profile);
+  if (!service || !service->loaded()) {
+    return;
+  }
+  const std::u16string needle = value == "duckduckgo" ? u"duckduckgo"
+                                : value == "bing"     ? u"bing"
+                                                      : u"google";
+  for (TemplateURL* turl : service->GetTemplateURLs()) {
+    if (base::i18n::ToLower(turl->keyword()).find(needle) !=
+        std::u16string::npos) {
+      service->SetUserSelectedDefaultSearchProvider(turl);
+      return;
+    }
+  }
+}
+
+void ApplyAdblockSetting(Profile* profile, const std::string& value) {
+  const bool enable = value == "on";
+  profile->GetPrefs()->SetBoolean("glint.adblock_enabled", enable);
+  auto* component_loader = extensions::ComponentLoader::Get(profile);
+  if (!component_loader) {
+    return;
+  }
+  if (enable) {
+    component_loader->AddGlintAdblock();
+  } else {
+    component_loader->RemoveGlintAdblock();
+  }
+}
+
+void OpenAdblockSettings(Browser* browser) {
+  const extensions::ExtensionSet& extension_set =
+      extensions::ExtensionRegistry::Get(browser->profile())
+          ->enabled_extensions();
+  for (const auto& extension : extension_set) {
+    if (extension->name().find("uBlock") != std::string::npos) {
+      NavigateParams params(browser,
+                            extension->ResolveExtensionURL("dashboard.html"),
+                            ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+      params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      Navigate(&params);
+      return;
+    }
+  }
+}
+
+namespace {
+
+// Glint profiles are REAL on-disk profiles ("glint-<name>" directories under
+// the user data dir): every keyed service exists (unlike named OTR profiles,
+// where missing services crashed tab-helper attachment), and logins persist
+// across restarts.
+Profile* GetGlintProfile(const std::string& name) {
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return nullptr;
+  }
+  std::string dir_name = "glint-";
+  for (char c : name) {
+    dir_name += base::IsAsciiAlphaNumeric(c) ? base::ToLowerASCII(c) : '-';
+  }
+  return profile_manager->GetProfile(
+      profile_manager->user_data_dir().AppendASCII(dir_name));
+}
+
+}  // namespace
+
+std::vector<std::string> GetGlintProfileNames() {
+  std::vector<std::string> names;
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return names;
+  }
+  for (const ProfileAttributesEntry* entry :
+       profile_manager->GetProfileAttributesStorage()
+           .GetAllProfilesAttributes()) {
+    const std::string base_name = entry->GetPath().BaseName().AsUTF8Unsafe();
+    if (base_name.rfind("glint-", 0) == 0) {
+      names.push_back(base_name.substr(6));
+    }
+  }
+  std::sort(names.begin(), names.end());
+  return names;
+}
+
+void OpenUrlInGlintProfile(Browser* browser,
+                           const std::string& profile_name,
+                           const std::u16string& url_text) {
+  Profile* glint_profile = GetGlintProfile(profile_name);
+  if (!glint_profile) {
+    return;
+  }
+
+  content::WebContents::CreateParams create_params(glint_profile);
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(create_params);
+  TabHelpers::AttachTabHelpersForGlint(contents.get());
+
+  content::NavigationController::LoadURLParams load_params(
+      ToNavigableUrl(browser, url_text));
+  load_params.transition_type = ui::PAGE_TRANSITION_TYPED;
+  contents->GetController().LoadURLWithParams(load_params);
+
+  // Join the CURRENT workspace: capture the active tab's group before
+  // appending, then group the new tab into it. Without this the tab lands
+  // ungrouped and the sidebar's adoption logic guesses (wrongly) — profile
+  // tabs must open in the workspace the user is standing in.
+  content::WebContents* raw_contents = contents.get();
+  TabStripModel* tab_strip = browser->tab_strip_model();
+  std::optional<tab_groups::TabGroupId> active_group =
+      tab_strip->GetTabGroupForTab(tab_strip->active_index());
+  tab_strip->AppendWebContents(std::move(contents), /*foreground=*/true);
+  if (active_group) {
+    tab_strip->AddToExistingGroup({tab_strip->active_index()}, *active_group);
+  }
+
+  // Tell the sidebar which profile this tab belongs to: write the
+  // tabId -> profile-name mapping straight into the Glint UI extension's
+  // chrome.storage.local ("glintProfileTabs"). The panel listens on
+  // storage.onChanged and badges the row.
+  const int tab_id = sessions::SessionTabHelper::IdForTab(raw_contents).id();
+  Profile* original = browser->profile()->GetOriginalProfile();
+  const extensions::ExtensionSet& extension_set =
+      extensions::ExtensionRegistry::Get(original)->enabled_extensions();
+  for (const auto& extension : extension_set) {
+    if (extension->name() != "Glint UI") {
+      continue;
+    }
+    extensions::StorageFrontend* frontend =
+        extensions::StorageFrontend::Get(original);
+    if (!frontend) {
+      break;
+    }
+    frontend->RunWithStorage(
+        extension, extensions::settings_namespace::LOCAL,
+        base::BindOnce(
+            [](int tab_id, std::string name, value_store::ValueStore* store) {
+              value_store::ValueStore::ReadResult read =
+                  store->Get("glintProfileTabs");
+              base::DictValue map;
+              if (read.status().ok()) {
+                base::DictValue* existing =
+                    read.settings().FindDict("glintProfileTabs");
+                if (existing) {
+                  map = std::move(*existing);
+                }
+              }
+              map.Set(base::NumberToString(tab_id), name);
+              store->Set(value_store::ValueStore::DEFAULTS, "glintProfileTabs",
+                         base::Value(std::move(map)));
+            },
+            tab_id, profile_name));
+    break;
+  }
+}
+
+void ActivateAdjacentWorkspace(Browser* browser, int delta) {
+  TabStripModel* tab_strip = browser->tab_strip_model();
+  if (tab_strip->empty()) {
+    return;
+  }
+  // Collect groups in tab order.
+  std::vector<tab_groups::TabGroupId> ordered_groups;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    std::optional<tab_groups::TabGroupId> group =
+        tab_strip->GetTabGroupForTab(i);
+    if (group && std::find(ordered_groups.begin(), ordered_groups.end(),
+                           *group) == ordered_groups.end()) {
+      ordered_groups.push_back(*group);
+    }
+  }
+  if (ordered_groups.empty()) {
+    return;
+  }
+
+  // Position of the active tab's group; step |delta| with wrap-around.
+  std::optional<tab_groups::TabGroupId> active_group =
+      tab_strip->GetTabGroupForTab(tab_strip->active_index());
+  size_t current = 0;
+  if (active_group) {
+    auto it =
+        std::find(ordered_groups.begin(), ordered_groups.end(), *active_group);
+    if (it != ordered_groups.end()) {
+      current = static_cast<size_t>(it - ordered_groups.begin());
+    }
+  }
+  const size_t count = ordered_groups.size();
+  const size_t target_index =
+      (current + count + static_cast<size_t>((delta % static_cast<int>(count)) +
+                                             static_cast<int>(count))) %
+      count;
+  const tab_groups::TabGroupId& target = ordered_groups[target_index];
+
+  // Focus the group's most recently active tab.
+  int best_index = -1;
+  base::TimeTicks best_time;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (tab_strip->GetTabGroupForTab(i) != target) {
+      continue;
+    }
+    content::WebContents* contents = tab_strip->GetWebContentsAt(i);
+    const base::TimeTicks last_active =
+        contents ? contents->GetLastActiveTimeTicks() : base::TimeTicks();
+    if (best_index == -1 || last_active > best_time) {
+      best_index = i;
+      best_time = last_active;
+    }
+  }
+  if (best_index != -1) {
+    tab_strip->ActivateTabAt(best_index);
+  }
+}
+
+void OpenGlintSettings(Browser* browser) {
+  const extensions::ExtensionSet& extension_set =
+      extensions::ExtensionRegistry::Get(browser->profile())
+          ->enabled_extensions();
+  for (const auto& extension : extension_set) {
+    if (extension->name() == "Glint UI") {
+      std::string profiles_param;
+      for (const std::string& name : GetGlintProfileNames()) {
+        if (!profiles_param.empty()) {
+          profiles_param += ",";
+        }
+        profiles_param += base::EscapeQueryParamValue(name, /*use_plus=*/false);
+      }
+      NavigateParams params(
+          browser,
+          extension->ResolveExtensionURL("settings.html?glintProfiles=" +
+                                         profiles_param),
+          ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+      params.disposition = WindowOpenDisposition::NEW_POPUP;
+      // App-style trusted popup: title bar only, no location bar.
+      params.app_id = extension->id();
+      params.trusted_source = true;
+      params.window_features.bounds = gfx::Rect(0, 0, 1000, 720);
+      Navigate(&params);
+      return;
+    }
+  }
+  chrome::ShowSettings(browser);
+}
+
+void ShowCommandPalette(Browser* browser) {
+  if (GlintCommandPaletteView::instance()) {
+    GlintCommandPaletteView::instance()->GetWidget()->Activate();
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return;
+  }
+  auto bubble =
+      std::make_unique<GlintCommandPaletteView>(browser, browser_view);
+  GlintCommandPaletteView* raw = bubble.get();
+  views::Widget* widget =
+      views::BubbleDialogDelegateView::CreateBubble(std::move(bubble));
+  GlintCommandPaletteView::set_instance(raw);
+  widget->Show();
+}
+
+}  // namespace glint
