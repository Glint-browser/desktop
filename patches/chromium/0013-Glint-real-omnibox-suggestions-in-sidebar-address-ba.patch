@@ -171,6 +185,28 @@ VerticalTabStripRegionView::VerticalTabStripRegionView(
   glint_address_bar_ = AddChildView(std::move(glint_address_bar));
   UpdateGlintAddressBar();
 
+  // Glint: autocomplete suggestions dropdown, shown under the address bar while
+  // typing. Sits directly below the field in the vertical layout.
+  auto suggestions = std::make_unique<views::View>();
+  auto* suggestions_layout =
+      suggestions->SetLayoutManager(std::make_unique<views::FlexLayout>());
+  suggestions_layout->SetOrientation(views::LayoutOrientation::kVertical);
+  suggestions->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(0, region_horizontal_padding, 4,
+                        region_horizontal_padding));
+  suggestions->SetVisible(false);
+  glint_suggestions_ = AddChildView(std::move(suggestions));
+
+  // Autocomplete engine: same providers (history, search, bookmarks, ...) the
+  // real omnibox uses.
+  glint_autocomplete_ = std::make_unique<AutocompleteController>(
+      std::make_unique<ChromeAutocompleteProviderClient>(
+          glint_browser_->profile()),
+      AutocompleteControllerConfig{
+          .provider_types = AutocompleteClassifier::DefaultOmniboxProviders()});
+  glint_autocomplete_->AddObserver(this);
+
   // Glint: workspace header row — folder icon + bold name (like the "Work"
   // space in the reference).
   auto workspace_row = std::make_unique<views::View>();
@@ -1285,10 +1321,88 @@ bool VerticalTabStripRegionView::HandleKeyEvent(
     url = GURL("https://www.google.com/search?q=" +
                base::EscapeQueryParamValue(text, /*use_plus=*/true));
   }
+  GlintOpenUrl(std::move(url));
+  return true;
+}
+
+void VerticalTabStripRegionView::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  // Only drive autocomplete for real user typing, not the programmatic URL sync
+  // in UpdateGlintAddressBar().
+  if (!glint_autocomplete_ || !glint_browser_ || !sender->HasFocus()) {
+    return;
+  }
+  if (new_contents.empty()) {
+    ClearGlintSuggestions();
+    return;
+  }
+  AutocompleteInput input(
+      new_contents, metrics::OmniboxEventProto::OTHER,
+      ChromeAutocompleteSchemeClassifier(glint_browser_->profile()));
+  input.set_focus_type(metrics::OmniboxFocusType::INTERACTION_DEFAULT);
+  glint_autocomplete_->Start(input);
+}
+
+void VerticalTabStripRegionView::OnResultChanged(
+    AutocompleteController* controller,
+    bool default_match_changed) {
+  if (!glint_suggestions_) {
+    return;
+  }
+  glint_suggestions_->RemoveAllChildViews();
+  int shown = 0;
+  for (const AutocompleteMatch& match : controller->result()) {
+    if (shown >= 6) {
+      break;
+    }
+    std::u16string label =
+        !match.contents.empty() ? match.contents : match.fill_into_edit;
+    if (label.empty() || !match.destination_url.is_valid()) {
+      continue;
+    }
+    auto row = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&VerticalTabStripRegionView::GlintOpenUrl,
+                            base::Unretained(this), match.destination_url),
+        label);
+    row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    glint_suggestions_->AddChildView(std::move(row));
+    ++shown;
+  }
+  glint_suggestions_->SetVisible(shown > 0);
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::GlintOpenUrl(GURL url) {
+  if (!glint_browser_ || !url.is_valid()) {
+    return;
+  }
+  // Defer: this may be invoked from a suggestion row's click handler, and the
+  // work below deletes that row. Posting avoids a use-after-free.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&VerticalTabStripRegionView::GlintNavigateAndClear,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(url)));
+}
+
+void VerticalTabStripRegionView::GlintNavigateAndClear(GURL url) {
+  if (!glint_browser_ || !url.is_valid()) {
+    return;
+  }
+  ClearGlintSuggestions();
   NavigateParams params(glint_browser_, url, ui::PAGE_TRANSITION_TYPED);
   params.disposition = WindowOpenDisposition::CURRENT_TAB;
   Navigate(&params);
-  return true;
+}
+
+void VerticalTabStripRegionView::ClearGlintSuggestions() {
+  if (glint_autocomplete_) {
+    glint_autocomplete_->Stop(AutocompleteStopReason::kClobbered);
+  }
+  if (glint_suggestions_) {
+    glint_suggestions_->RemoveAllChildViews();
+    glint_suggestions_->SetVisible(false);
+  }
 }
 
