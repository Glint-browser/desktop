 chrome/browser/resources/glint_ui/manifest.json        | 2 +-
 chrome/browser/resources/glint_ui/settings.js          | 2 +-
 chrome/browser/resources/glint_ui/sidepanel.js         | 2 +-
 chrome/browser/ui/views/glint/glint_command_palette.cc | 4 +++-
 5 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/resources/glint_ui/assets/styles.css b/chrome/browser/resources/glint_ui/assets/styles.css
index 63fe18d436..55d8daac76 100644
