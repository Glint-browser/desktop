+void DeleteGlintProfile(const std::string& name) {
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return;
+  }
+  std::string dir_name = "glint-";
+  for (char c : name) {
+    dir_name += base::IsAsciiAlphaNumeric(c) ? base::ToLowerASCII(c) : '-';
+  }
+  const base::FilePath path =
+      profile_manager->user_data_dir().AppendASCII(dir_name);
+
+  // Close the profile's tabs wherever they live (they sit in OTHER
+  // profiles' windows) before tearing the profile down.
+  for (BrowserWindowInterface* bwi : GetAllBrowserWindowInterfaces()) {
+    Browser* open_browser = bwi->GetBrowserForMigrationOnly();
+    if (!open_browser) {
+      continue;
+    }
+    TabStripModel* tab_strip = open_browser->tab_strip_model();
+    for (int i = tab_strip->count() - 1; i >= 0; --i) {
+      content::WebContents* contents = tab_strip->GetWebContentsAt(i);
+      if (contents && Profile::FromBrowserContext(contents->GetBrowserContext())
+                              ->GetPath() == path) {
+        tab_strip->CloseWebContentsAt(i, TabCloseTypes::CLOSE_USER_GESTURE);
+      }
+    }
+  }
+
+  profile_manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+      path, base::DoNothing(),
+      ProfileMetrics::DELETE_PROFILE_USER_MANAGER);
+}
