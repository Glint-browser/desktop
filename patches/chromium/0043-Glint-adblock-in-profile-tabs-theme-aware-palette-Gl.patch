-// The Electron Glint palette colors, copied verbatim from styles.css:
-// --panel-strong over the gray ground, --text, --text-dim, --hover.
-constexpr SkColor kGlintPanel = SkColorSetRGB(0xF5, 0xF4, 0xF8);
-constexpr SkColor kGlintText = SkColorSetRGB(0x2B, 0x27, 0x33);
-constexpr SkColor kGlintTextDim = SkColorSetRGB(0x6B, 0x66, 0x75);
-constexpr SkColor kGlintHover = SkColorSetA(SK_ColorBLACK, 0x0D);
+// The Electron Glint palette colors (styles.css), light + dark variants.
+struct GlintPaletteColors {
+  SkColor panel;
+  SkColor text;
+  SkColor text_dim;
+  SkColor hover;
+};
+
+constexpr GlintPaletteColors kGlintLight = {
+    SkColorSetRGB(0xF5, 0xF4, 0xF8), SkColorSetRGB(0x2B, 0x27, 0x33),
+    SkColorSetRGB(0x6B, 0x66, 0x75), SkColorSetA(SK_ColorBLACK, 0x0D)};
+
+constexpr GlintPaletteColors kGlintDark = {
+    SkColorSetRGB(0x26, 0x24, 0x30), SkColorSetRGB(0xE8, 0xE6, 0xF0),
+    SkColorSetRGB(0x9A, 0x95, 0xAD), SkColorSetA(SK_ColorWHITE, 0x14)};
+
+// Follows the browser color scheme (Glint settings > Appearance), falling
+// back to the OS for "System".
+const GlintPaletteColors& PaletteColorsFor(Browser* browser) {
+  ThemeService* theme_service =
+      ThemeServiceFactory::GetForProfile(browser->profile());
+  bool dark = false;
+  if (theme_service) {
+    switch (theme_service->GetBrowserColorScheme()) {
+      case ThemeService::BrowserColorScheme::kDark:
+        dark = true;
+        break;
+      case ThemeService::BrowserColorScheme::kLight:
+        dark = false;
+        break;
+      case ThemeService::BrowserColorScheme::kSystem:
+        dark = ui::NativeTheme::GetInstanceForNativeUi()
+                   ->preferred_color_scheme() ==
+               ui::NativeTheme::PreferredColorScheme::kDark;
+        break;
+    }
+  }
+  return dark ? kGlintDark : kGlintLight;
+}
