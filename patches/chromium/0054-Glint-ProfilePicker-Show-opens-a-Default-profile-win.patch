diff --git a/chrome/browser/ui/views/profiles/profile_picker_view.cc b/chrome/browser/ui/views/profiles/profile_picker_view.cc
index b6b16dd30d..bb29a58aa6 100644
--- a/chrome/browser/ui/views/profiles/profile_picker_view.cc
+++ b/chrome/browser/ui/views/profiles/profile_picker_view.cc
@@ -3,6 +3,8 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/ui/views/profiles/profile_picker_view.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/common/chrome_constants.h"
 
 #include <algorithm>
 
@@ -151,6 +153,23 @@ void ClearLockedProfilesFirstBrowserKeepAlive() {
 
 // static
 void ProfilePicker::Show(Params&& params) {
+  // Glint: the profile picker never shows — Glint profiles are tab
+  // sessions, not window identities. Every entry point (startup handled in
+  // startup_browser_creator, Dock reopen, menus) opens a Default-profile
+  // window instead.
+  static volatile bool glint_no_profile_picker = true;
+  if (glint_no_profile_picker) {
+    ProfileManager* profile_manager = g_browser_process->profile_manager();
+    if (profile_manager) {
+      Profile* default_profile = profile_manager->GetProfile(
+          profile_manager->user_data_dir().AppendASCII(chrome::kInitialProfile));
+      if (default_profile) {
+        chrome::NewEmptyWindow(default_profile);
+      }
+    }
+    return;
+  }
+
   // Re-open with new params if necessary.
   if (g_profile_picker_view && g_profile_picker_view->MaybeReopen(params)) {
     return;
