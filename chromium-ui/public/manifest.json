{
  "manifest_version": 3,
  "name": "Glint UI",
  "version": "1.0.1",
  "description": "Glint sidebar \u2014 spaces, tabs, favorites, bookmarks. The Glint browser UI running natively on Chromium.",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "history",
    "storage",
    "sidePanel",
    "favicon",
    "management",
    "downloads",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Glint sidebar"
  }
}